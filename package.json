{
  "name": "apronhanger-candidate",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/ui": "~58.0.23",
    "@sentry/react-native": "~8.28.0",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.17",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "jest-expo": "~58.0.12",
    "msw": "^3.0.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:contract": "jest --config tests/contract/jest.config.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test -- --ci",
    "e2e:web": "playwright test",
    "e2e:android": "adb reverse tcp:3000 tcp:3000 && adb reverse tcp:8081 tcp:8081 && maestro test e2e/maestro",
    "backend:local": "node scripts/backend-local.ts",
    "drift-check": "node scripts/drift-check.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/contract/",
      "/e2e/",
      "/.reference-backend/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/app/**",
      "!src/test/**",
      "!**/__tests__/**"
    ],
    "coverageThreshold": {
      "./src/api/": {
        "lines": 85
      },
      "./src/lib/": {
        "lines": 85
      },
      "./src/features/": {
        "lines": 85
      }
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/.*|native-base|standard-navigation|msw|@msw|@mswjs|@open-draft|rettime|until-async|outvariant|headers-polyfill|is-node-process|strict-event-emitter|@bundled-es-modules|cookie|tough-cookie|tldts|tldts-core|@inquirer|graphql))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "transform": {
      "^.+.mjs$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "mjs",
      "cjs",
      "json"
    ],
    "testEnvironment": "<rootDir>/src/test/jestEnvironment.js",
    "modulePathIgnorePatterns": [
      "<rootDir>/.reference-backend/"
    ],
    "fakeTimers": {
      "doNotFake": [
        "nextTick",
        "setImmediate",
        "clearImmediate",
        "queueMicrotask"
      ]
    }
  }
}
