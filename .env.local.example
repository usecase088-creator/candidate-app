# Local development / testing only. Gitignored. Never production values (D13).
# Owner of these accounts: client's project email (D7).

# ── Neon dev database (project in ap-southeast-1) ─────────────────────────────
# Pooled (used by the app server)
DATABASE_URL=
# Direct (used by prisma migrate). Same host without "-pooler".
DATABASE_URL_UNPOOLED=

# ── Cloudinary dev (D14) ───────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Local backend secrets (generated locally, not shared with any server) ─────
JWT_SECRET=
NODE_ENV=
PORT=
ALLOWED_ORIGINS_CANDIDATE=

# ── Dummies: backend refuses to start without these; no real calls in dev ─────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
BREVO_API_KEY=
FAST2SMS_API_KEY=
FAST2SMS_VERIFICATION_TEMPLATE_ID=
FAST2SMS_RESET_TEMPLATE_ID=

# ── OTP test mode for the local backend copy (D3, Task 4 patch) ───────────────
OTP_TEST_MODE=
OTP_TEST_NUMBERS=
# Raj's own number for manual real-SMS checks only. Fill in yourself; never commit.
TEST_MOBILE=

# ── Not filled yet ─────────────────────────────────────────────────────────────
# Sentry DSN of the React Native project (public value, goes to EXPO_PUBLIC_SENTRY_DSN)
EXPO_PUBLIC_SENTRY_DSN=
# Render API key, read-only use (deploy history for D6)
RENDER_API_KEY=
